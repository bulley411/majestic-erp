{
  "name": "majestic-erp",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "pnpm --filter @mapa/shared test && pnpm --filter @mapa/api test",
    "db:migrate": "pnpm --filter @mapa/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @mapa/api exec tsx prisma/seed.ts",
    "dev:api": "pnpm --filter @mapa/api dev",
    "dev:web": "pnpm --filter @mapa/web dev",
    "db:seed:demo": "pnpm --filter @mapa/api exec tsx prisma/seed-demo.ts",
    "db:reset": "pnpm --filter @mapa/api exec prisma migrate reset --force"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}