{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022", "DOM"],
    "moduleResolution": "node", "esModuleInterop": true, "skipLibCheck": true,
    "strict": true, "strictPropertyInitialization": false,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "resolveJsonModule": true, "forceConsistentCasingInFileNames": true
  }
}
